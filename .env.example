NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vimeo API (https://developer.vimeo.com/apps で取得)
VIMEO_ACCESS_TOKEN=your-vimeo-access-token

# 提出×添削 機能（FEATURE_SUBMISSION_REVIEW が true のときだけ有効。既定オフ）
FEATURE_SUBMISSION_REVIEW=false
# 定期ジョブ（SLA監視・リマインド送信）用の共有シークレット（Phase 2 以降・Render Cron から /api/cron/* を叩く）
CRON_SECRET=your-cron-secret
# メール送信（既存の admin/reminders と共用。Resend）
RESEND_API_KEY=your-resend-api-key
REMINDER_FROM=onboarding@resend.dev
# ナビ表示用（クライアント側）。サーバ側 FEATURE_SUBMISSION_REVIEW と両方 true にする
NEXT_PUBLIC_FEATURE_SUBMISSION_REVIEW=false

# 育成プログラム Phase A（スキルマップ＆グレード）
FEATURE_SKILL_MAP=false
NEXT_PUBLIC_FEATURE_SKILL_MAP=false

# 育成プログラム Phase C（ピアレビュー＆添削者育成）
FEATURE_PEER_REVIEW=false
NEXT_PUBLIC_FEATURE_PEER_REVIEW=false

# 育成プログラム Phase D（AIコーチ）
FEATURE_AI_COACH=false
NEXT_PUBLIC_FEATURE_AI_COACH=false
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_COACH_MODEL=claude-sonnet-5-5

# 育成プログラム Phase E（コホート/デモデイ）
FEATURE_COHORT=false
NEXT_PUBLIC_FEATURE_COHORT=false

# 育成プログラム Phase F（認定・企業管理・受講記録）
FEATURE_CERTIFICATION=false
NEXT_PUBLIC_FEATURE_CERTIFICATION=false
