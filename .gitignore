# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e-learning video content: keep sources (memo/script/gen_slides/slides), ignore heavy generated artifacts
content/**/work/
content/**/output.mp4
content/**/narration*.mp3
content/**/narration.txt
content/**/*.pdf
# extracted skill copy (original zip is kept as reference)
materials/video-elearning-skill/

# Python cache
__pycache__/
*.pyc

# Slack由来の社内ネタメモ（顧客情報を含むため未コミット）
content/slack_ネタ候補.md
